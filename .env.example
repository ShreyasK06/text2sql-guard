# Copy to .env (git-ignored). Everything has a working default for the local docker-compose database.
T2S_DB_HOST=127.0.0.1
T2S_DB_PORT=54329
T2S_DB_NAME=t2s
T2S_OWNER_USER=t2s_owner
T2S_OWNER_PASSWORD=t2s_local_dev_only
T2S_ROLE_PASSWORD=t2s_local_dev_only

# LLM provider: mock (default, no key, nothing leaves the machine) | nvidia | openai_compatible | anthropic | gemini
# A live provider is opt-in: a key alone does not switch it on, LLM_PROVIDER must be set.
LLM_PROVIDER=mock

# Free NVIDIA-hosted models (https://build.nvidia.com). Questions and the role-visible schema are sent to NVIDIA.
# Key looks like nvapi-... ; never commit it. Clear NVIDIA_MODEL to pick from the live model list
# (GET /llm/models shows it); set it to override. Documented default from the small dev-set benchmark
# (README: Model benchmark); the code resolves ids from the live list, so check it still exists there.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Any other OpenAI-compatible endpoint (LLM_PROVIDER=openai_compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Client-side cap on LLM requests per minute (the free tier is shared and rate limited) and the optional
# second-call self-check (default: off for nvidia/openai_compatible, on for anthropic/gemini)
LLM_RATE_LIMIT_PER_MIN=30
LLM_SELF_CHECK=

# Other providers (T2S_LLM_PROVIDER / T2S_LLM_MODEL are still accepted as older names)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
