# Copy to .env (git-ignored). Everything has a working default for the local docker-compose database.
T2S_DB_HOST=127.0.0.1
T2S_DB_PORT=54329
T2S_DB_NAME=t2s
T2S_OWNER_USER=t2s_owner
T2S_OWNER_PASSWORD=t2s_local_dev_only
T2S_ROLE_PASSWORD=t2s_local_dev_only

# LLM provider: mock (default, no key needed) | anthropic | gemini
T2S_LLM_PROVIDER=mock
T2S_LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
