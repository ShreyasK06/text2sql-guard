# Public path the site is served from. './' works anywhere; Pages uses /text2sql-guard/.
VITE_BASE=./
# auto (default): use the API if /health answers, else the recorded demo.
# demo: recorded demo only (what GitHub Pages builds). live: API only.
VITE_MODE=auto
# Where the API lives. Empty = same origin, relative to the app base.
VITE_API_BASE=
